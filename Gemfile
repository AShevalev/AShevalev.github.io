source "https://rubygems.org"

# Use the github-pages gem so local builds match how GitHub Pages builds and
# serves this site (it pins Jekyll and the supported plugin versions).
gem "github-pages", group: :jekyll_plugins

# Ruby 3.0+ no longer ships webrick, which `jekyll serve` needs.
gem "webrick", "~> 1.8"

# Boot-time performance for watching files on Linux.
gem "jekyll-watch"
