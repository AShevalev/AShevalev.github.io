{
  "id": "https://www.verodus.com/",
  "name": "Verodus",
  "short_name": "Verodus",
  "description": "Track evaluations, launch TradeHub and Platform 5. Installed from verodus.com.",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#07003B",
  "theme_color": "#07003B",
  "orientation": "any",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "scope_extensions": [
    { "type": "origin", "origin": "https://dashboard.verodus.com" },
    { "type": "origin", "origin": "https://trade.verodus.com" }
  ],
  "icons": [
    {
      "src": "/images/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
