{
  "id": "https://dashboard.verodus.com/",
  "name": "Verodus",
  "short_name": "Verodus",
  "description": "Track objectives, drawdown and performance rewards. Launch TradeHub or Platform 5 from your accounts.",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#07003B",
  "theme_color": "#07003B",
  "orientation": "portrait-primary",
  "lang": "en",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "scope_extensions": [
    { "type": "origin", "origin": "https://trade.verodus.com" }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
